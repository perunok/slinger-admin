# Copy to .env and fill in. Values marked REQUIRED have no default: `docker compose up` refuses to start without them.
# Quoting: wrap JSON in single quotes; write a literal "$" as "$$".

# ---- PostgreSQL (bundled container) ----
POSTGRES_DB=slinger
POSTGRES_USER=slinger
# REQUIRED. URL-safe characters only (it is embedded in DATABASE_URL), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Server secrets ----
# REQUIRED. >= 32 chars, never reuse the example. Generate with: openssl rand -hex 32
# Changing it invalidates all sessions/tokens.
SLINGER_SIGNING_SECRET=
# REQUIRED. Strictly validated JSON array; at most one super_admin; passwords >= 12 chars (no defaults like "admin").
# Accounts are created at boot if missing; existing accounts are never modified. Dashboard login is email + password.
# roles: super_admin | platform_admin
SLINGER_ADMIN_BOOTSTRAP='[{"email":"admin@example.com","password":"CHANGE-ME-to-a-long-passphrase","display_name":"Bootstrap Admin","platform_role":"super_admin"}]'

# ---- Public URL / HTTPS ----
# Public base URL as seen by users and the desktop app (used to build the device-login link).
SLINGER_BASE_URL=http://localhost
# HTTP mode (default): keep Caddyfile as is and SLINGER_COOKIE_SECURE=false (Secure cookies are never sent over http://).
# HTTPS mode: uncomment the four lines below, set the domain, and make SLINGER_BASE_URL https://<domain>.
#SLINGER_CADDYFILE=./deploy/Caddyfile.https
#SLINGER_DOMAIN=cloud.example.com
#SLINGER_BASE_URL=https://cloud.example.com
#SLINGER_COOKIE_SECURE=true
SLINGER_COOKIE_SECURE=false
SLINGER_HTTP_PORT=80
SLINGER_HTTPS_PORT=443

# ---- Optional ----
# Extra browser origins allowed to call the API with credentials (comma-separated bare origins). Not needed for the
# bundled dashboard, which the server serves from its own origin. Never "*".
SLINGER_ALLOWED_ORIGINS=
# Domain under which workspaces may get dedicated subdomains (e.g. sling.example.com). Empty disables that host kind.
SLINGER_SHARED_DOMAIN=
# Image name/tag (compose builds it from server/Dockerfile, dashboard included), e.g. <namespace>/slinger-server:0.2.0.
SLINGER_SERVER_IMAGE=slinger-server:latest
