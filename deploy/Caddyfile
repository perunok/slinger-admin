# DEFAULT: plain HTTP on :80 (HTTPS is OFF). Fine for a LAN / behind another TLS terminator / local trials.
# For real deployments use deploy/Caddyfile.https (automatic Let's Encrypt) and set SLINGER_COOKIE_SECURE=true.
#
# Everything goes to the server: the API (/v1, /api/v1 for the dashboard, /device, /healthz) and the admin dashboard ("/").
# The server sets its own security headers, so this only adds compression.
{
	auto_https off
}

:80 {
	encode zstd gzip

	header -Server

	reverse_proxy server:8080
}
