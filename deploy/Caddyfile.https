# HTTPS with automatic certificates (Let's Encrypt). Enable with, in .env:
#   SLINGER_CADDYFILE=./deploy/Caddyfile.https
#   SLINGER_DOMAIN=cloud.example.com      (DNS A/AAAA record must point at this host; ports 80+443 must be reachable)
#   SLINGER_BASE_URL=https://cloud.example.com
#   SLINGER_COOKIE_SECURE=true            (also makes the server send Strict-Transport-Security)
# Routing is identical to deploy/Caddyfile: everything goes to the server. HTTP on :80 is redirected to HTTPS by Caddy.
{$SLINGER_DOMAIN} {
	encode zstd gzip

	header -Server

	reverse_proxy server:8080
}
